<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ServerGrid.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        // Connect straight over WebSockets and skip the SignalR negotiate request: one round trip less on every
        // page load. Trade-off: no fallback to long polling if a proxy blocks WebSockets (transport 1 = WebSockets).
        Blazor.start({
            circuit: {
                configureSignalR: builder => builder.withUrl('_blazor', { skipNegotiation: true, transport: 1 })
            }
        });
    </script>
</body>

</html>
